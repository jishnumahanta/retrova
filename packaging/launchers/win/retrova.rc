// Resources for Retrova.exe. Built by packaging/rbuild/win.py with
//   windres -DRETROVA_VER_COMMA=1,0,0,0 -DRETROVA_VER_STR=\"1.0.0\" -DRETROVA_ICON=\"Retrova.ico\"
#include <winver.h>

// First icon = the exe icon (Explorer, taskbar, pywebview window icon via ExtractIconW).
1 ICON RETROVA_ICON

// Application manifest (asInvoker, Win7-11, long paths, common controls v6).
1 24 "retrova.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     RETROVA_VER_COMMA
PRODUCTVERSION  RETROVA_VER_COMMA
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Retrova"
            VALUE "FileDescription",  "Retrova"
            VALUE "FileVersion",      RETROVA_VER_STR
            VALUE "InternalName",     "Retrova"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Jishnu Mahanta. AGPL-3.0"
            VALUE "OriginalFilename", "Retrova.exe"
            VALUE "ProductName",      "Retrova"
            VALUE "ProductVersion",   RETROVA_VER_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
